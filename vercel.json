{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/page.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/syncDisasters",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/syncDisasters": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/**": {
      "maxDuration": 50
    }
  }
}
